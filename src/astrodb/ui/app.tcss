Screen {
    background: $background;
    align: center middle;
    padding: 1 2;
}

#app-container {
    border: round white;
    height: 100%;
    padding: 0 2 1 2;
    margin: 1 2;
}

#header-panel {
    height: auto;
    margin-bottom: 0;
}

#header-panel Rule {
    margin: 0;
    height: 1;
}

#header-inner {
    height: auto;
    margin-bottom: 0;
}

#logo {
    width: auto;
    height: auto;
}

#header-labels {
    width: 1fr;
    height: auto;
    padding-left: 2;
    align: left middle;
    content-align: left middle;
}

#db-label {
    margin-bottom: 0;
    width: auto;
    text-style: bold;
}

#status-bar {
    margin-bottom: 0;
    width: 100%;
}

#main-layout {
    height: 1fr;
}

#left-panel {
    width: 3fr;
    height: 100%;
}

#editor-container {
    height: 3fr;
}

#adql-editor {
    height: 1fr;
    border: none;
    background: transparent;
}

#editor-toolbar {
    height: 1;
    align: left middle;
    padding: 0 1;
}

#editor-toolbar Button {
    height: 1;
    min-width: 0;
    width: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
}

#results-container {
    height: 2fr;
    border-top: solid $primary-darken-2;
    padding-top: 1;
}

#results-title {
    margin-bottom: 1;
}

#results-table {
    height: 1fr;
}

#sidebar-container {
    width: 1fr;
    height: 100%;
    border-left: solid white;
    padding-left: 2;
    overflow-y: auto;
}

#sidebar-container Rule {
    margin: 0;
    height: 1;
}

#table-label {
    margin-bottom: 0;
}

#columns-title {
    margin-bottom: 0;
}

#cols-filter {
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0;
    background: $surface;
}

#cols-filter:focus {
    border-left: tall $accent;
}

#columns-list {
    height: auto;
    max-height: 12;
    border: none;
    overflow-y: auto;
}

#columns-list > ListItem {
    padding: 0 1;
}

#adql-editor:focus {
    border: tall $accent;
}

#columns-list:focus {
    border-left: tall $accent;
}

#history-list:focus {
    border-left: tall $accent;
}

#history-title {
    margin-top: 0;
    margin-bottom: 0;
}

#history-list {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    border: none;
}

#history-list > ListItem {
    padding: 0 1;
}

.hidden {
    display: none;
}

/* Editor filebar */
#editor-filebar {
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface;
    layout: horizontal;
    align: left middle;
}

#editor-filebar Label {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
}

#editor-filebar #save-status {
    width: 1fr;
    height: 1;
    padding: 0 1 0 0;
}

#editor-filebar Button {
    height: 1;
    width: auto;
    min-width: 10;
    margin: 0 0 0 1;
    border: none;
    padding: 0 1;
    background: #3A3550;
    color: #D4BBFB;
}

#btn-save-adql {
    background: #2A4A2A;
    color: #A8E6A8;
    min-width: 14;
}

#btn-load-adql, #btn-new-adql {
    min-width: 12;
}

#save-name-row {
    height: 1;
    margin-bottom: 1;
}

#save-name-row Input {
    width: 30;
    border: none;
    background: #3A3A3A;
    color: #E0E0E0;
}

#save-name-row Button {
    margin: 0 0 0 1;
    border: none;
    height: 1;
    padding: 0 1;
}

#export-name-row, #export-type-row, #export-table-row {
    height: 1;
    margin-bottom: 1;
}

#export-name-row Label, #export-type-row Label, #export-table-row Label {
    width: 22;
    height: 1;
    content-align: left middle;
}

#export-name-row Input, #export-table-row Input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: #3A3A3A;
    color: #E0E0E0;
}

#export-type-row Button {
    margin: 0 1 0 0;
    height: 1;
    min-width: 10;
    border: none;
    padding: 0 1;
}

#exp-csv { color: #5DADE2; }
#exp-db { color: #E89D3A; }

LoadAdqlModal, SaveDirModal {
    align: center middle;
}

#save-dir-current {
    margin-bottom: 1;
    height: 1;
    content-align: left middle;
}

#save-dir-bar {
    height: 1;
    margin-bottom: 1;
}

#save-dir-bar Button {
    height: 1;
    border: none;
    padding: 0 1;
    margin-right: 1;
    min-width: 6;
}

#save-dir-tree {
    height: 1fr;
    border: round $accent;
}

#load-modal {
    background: $surface;
    border: round $primary;
    padding: 1 2;
    width: 70;
    height: 24;
}

#load-modal-title {
    text-align: center;
    margin-bottom: 1;
}

#adql-tree {
    height: 1fr;
    border: round $accent;
}

#load-modal-buttons {
    height: 1;
    align: center middle;
    margin-top: 1;
}

#load-modal-buttons Button {
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1;
    min-width: 14;
}

#btn-cancel {
    background: #4A2A2A;
    color: #E6A8A8;
    min-width: 16;
}

#btn-cancel:disabled {
    background: #2A2A2A;
    color: #555555;
}

#cancel-picker-list {
    height: 1fr;
    border: round $accent;
}
